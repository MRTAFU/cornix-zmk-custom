/*
 * 2026-09-12: Migrated from the RMK v1.12 / Vial keymap the user was
 * actually running on hardware (reference/20260905_cornix.vil, 4 real
 * layers: Base / LOWER / RAISE / ADJUST; Layers 4-9 in the .vil are
 * KC_NO-only with no reachable layer switch, combo, tap-dance, macro or
 * user key pointing at them, so they are intentionally not ported — see
 * MIGRATION.md). Layer 0-3 keys are carried over 1:1 by physical position.
 *
 * LOWER/RAISE replace the RMK Tap Dance (TD(0)/TD(1), term 175ms,
 * tap=LANG2/LANG1, hold=MO(1)/MO(2)) and the TD(0)+TD(1) combo (->MO(3))
 * with the dedicated `cornix_layer_gate` out-of-tree behavior
 * (dts/behaviors/cornix_layer_gate.dtsi, src/behaviors/behavior_cornix_layer_gate.c):
 * the target layer activates the instant the key goes down (not after a
 * tap-term wait), and a LANG1/LANG2 tap is only sent on release if no
 * other physical key was pressed while held and the hold was under the
 * new 350ms tap-term. ADJUST (ex-MO(3)) is Layer 3, entered via a
 * standard `conditional_layers` tri-layer (if-layers = <1 2>) below,
 * matching upstream ZMK convention rather than a hand-rolled layer stack.
 *
 * USER00/USER01/USER02 on the .vil's Layer 3 were the RMK/Vial Bluetooth
 * profile-slot selection keys; they are ported to `&bt BT_SEL 0/1/2`.
 *
 * Positions unchanged from Base (LOWER/RAISE/ADJUST held modifiers,
 * left/right inner-thumb mouse-click/mute keys) are expressed as &trans
 * rather than repeating the same &kp, which is behavior-identical to how
 * the .vil re-lists them per layer.
 *
 * ZMK Studio interaction:
 *   - Studio overrides per-layer `bindings` via NVS at runtime; the
 *     `bindings` here are the post-reset / pre-Studio-edit defaults.
 *   - Studio does NOT cover `sensor-bindings` (encoders), conditional_layers,
 *     or behaviors - those keep being controlled by this file at runtime
 *     regardless of Studio state.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/cornix_layer_gate.dtsi>

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp TAB &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U &kp I &kp O &kp P &kp MINUS
&kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &mkp MCLK &kp C_MUTE   &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
&kp LCTRL &kp LGUI &kp LALT &kp LGUI &lower_gate &kp SPACE   &kp RET &raise_gate &kp RALT &kp RALT &kp RGUI &kp K_APP
            >;
            sensor-bindings = <&scroll_encoder &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        LOWER {
            display-name = "LOWER";
            bindings = <
&kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
&trans &none &none &none &none &none   &kp LEFT &kp DOWN &kp UP &kp RIGHT &none &none
&trans &none &none &none &none &none   &trans &trans   &none &none &none &none &none &trans
&trans &trans &trans &trans &lower_gate &trans   &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&scroll_encoder &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        RAISE {
            display-name = "RAISE";
            bindings = <
&kp TILDE &kp EXCLAMATION &kp AT_SIGN &kp HASH &kp DOLLAR &kp PERCENT   &kp CARET &kp AMPERSAND &kp ASTERISK &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp UNDERSCORE
&trans &none &none &none &none &none   &kp KP_PLUS &kp KP_EQUAL &kp LEFT_BRACE &kp RIGHT_BRACE &kp COLON &kp DOUBLE_QUOTES
&trans &none &none &none &none &none   &trans &trans   &kp PIPE &kp GRAVE &kp LBKT &kp RBKT &kp QUESTION &kp BSLH
&trans &trans &trans &trans &trans &trans   &trans &raise_gate &trans &trans &trans &trans
            >;
            sensor-bindings = <&scroll_encoder &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        ADJUST {
            display-name = "ADJUST";
            bindings = <
&none &none &none &none &none &none   &none &none &none &none &none &none
&bt BT_SEL 0 &none &none &none &none &none   &none &none &none &none &none &none
&bt BT_SEL 1 &none &none &none &none &none   &trans &trans   &none &none &none &none &none &none
&bt BT_SEL 2 &none &none &none &trans &none   &none &trans &none &none &none &none
            >;
            sensor-bindings = <&scroll_encoder &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
