CONFIG_ADC_NRFX_SAADC=y

# Enable MPU
CONFIG_ARM_MPU=y

# Use pinctrl
CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

CONFIG_ZMK_SPLIT=y

CONFIG_ZMK_BLE=y

# never output usb
CONFIG_ZMK_USB=n

CONFIG_INPUT=y

# RGB
#CONFIG_SPI=n
#CONFIG_ZMK_EXT_POWER=n

CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# NOTE: BT_PERIPHERAL_PREF_* does nothing on the split link, so the
# latency=5 that used to live here (refs #7) never took effect. ZMK sets
# BT_GAP_AUTO_UPDATE_CONN_PARAMS=n for split peripherals
# (app/src/split/bluetooth/Kconfig, "Allow central to specify connection
# parameters."), and Zephyr only sends a peripheral-initiated param update
# from inside that guard (host/conn.c). The central never reads our PPCP
# either. The parameters that actually apply are chosen by the central in
# split/bluetooth/central.c from CONFIG_ZMK_SPLIT_BLE_PREF_* — see
# cornix_left_defconfig.
# CONFIG_BT_PERIPHERAL_PREF_LATENCY=5

# Match the central's TX power. Left runs at +8 dBm
# (cornix_left_defconfig) while this side had no TX setting at all and so
# fell back to Zephyr's `default BT_CTLR_TX_PWR_0` = 0 dBm. That put the
# whole 8 dB deficit on the Right->Left direction, which is exactly the
# direction every key event travels.
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Run the split link on 1M PHY instead of 2M. ZMK_SPLIT_BLE selects
# BT_USER_PHY_UPDATE + BT_AUTO_PHY_UPDATE unconditionally, so Zephyr
# auto-negotiates symmetric 2M on connect
# (host/conn.c perform_auto_initiated_procedures) whenever the controller
# advertises the feature. 2M trades several dB of link budget for
# throughput a 6-byte position bitmap does not need. This is the same
# thing CONFIG_ZMK_BLE_EXPERIMENTAL_CONN does — its only effect today is
# `BT_CTLR_PHY_2M default n` — spelled out explicitly so it cannot pick up
# extra meaning as upstream main moves.
CONFIG_BT_CTLR_PHY_2M=n

