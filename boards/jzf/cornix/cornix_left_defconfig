# e73 config

CONFIG_ADC_NRFX_SAADC=y

# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y

CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y

CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

# e73 config end

CONFIG_ZMK_KEYBOARD_NAME="Cornix"
CONFIG_ZMK_USB=y
CONFIG_ZMK_SPLIT=y
CONFIG_ZMK_SPLIT_ROLE_CENTRAL=y

# 增加键盘的 BLE 无线电的发射功率，用解决延迟和左右通讯不佳的问题
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y
# 更改键盘默认显示名称

# Run BLE on 1M PHY instead of 2M — see the matching block in
# cornix_right_defconfig for the full reasoning. Both halves need it: the
# 2M negotiation is symmetric, so it also has to be off on the side that
# initiates it. This also drops the Left<->host link to 1M, which is the
# conservative choice for a keyboard.
CONFIG_BT_CTLR_PHY_2M=n

# Parameters for the Left<->Right split link. The central picks these for
# both halves (split/bluetooth/central.c passes them to bt_conn_le_create);
# the peripheral's own BT_PERIPHERAL_PREF_* are ignored.
#
# Supervision timeout, in units of 10 ms. ZMK's default of 400 = 4 s is
# what sets the length of the stuck-key burst: when the link dies mid-press
# the central only learns about it — and only then force-releases the held
# positions in release_peripheral_slot() — after this timeout expires, so
# the host sees the key held and auto-repeats for the whole window. 100 =
# 1 s cuts that from ~40 repeated characters to a few. The trade-off is
# less tolerance for brief RF dropouts, i.e. more (but far shorter)
# reconnects. Floor is (1 + latency) * interval * 2 = 90 ms here.
CONFIG_ZMK_SPLIT_BLE_PREF_TIMEOUT=100

# Slave latency, in connection events. Default 30 lets the peripheral skip
# ~232 ms of conn events at the 7.5 ms interval. 5 caps the worst-case skip
# near ~45 ms at some cost in peripheral idle current. (This is the knob
# #7 was trying to reach via the peripheral side, where it had no effect.)
CONFIG_ZMK_SPLIT_BLE_PREF_LATENCY=5

# 电池电量报告间隔时间单位是秒
CONFIG_ZMK_BATTERY_REPORT_INTERVAL=60

CONFIG_PINCTRL=y

CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# enable display drivers
CONFIG_ZMK_DISPLAY=n

#BLE-passkey
CONFIG_ZMK_BLE_PASSKEY_ENTRY=n

#BLE-clean
CONFIG_ZMK_BLE_CLEAR_BONDS_ON_START=n

CONFIG_ZMK_HID_REPORT_TYPE_NKRO=n

CONFIG_ZMK_POINTING=y

# 3 profiles (n+2)
CONFIG_BT_MAX_CONN=6
CONFIG_BT_MAX_PAIRED=6

CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING=y

# zmk studio相关配置
CONFIG_ZMK_STUDIO=y
CONFIG_ZMK_STUDIO_LOCKING=n
CONFIG_ZMK_STUDIO_LOCK_ON_DISCONNECT=n
